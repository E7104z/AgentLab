# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...

# =============================================================================
# MASTER KILL SWITCH (fail-safe)
# The agent takes NO automatic outbound action -- no email send/draft, no inbox
# polling, no automatic SMS reply -- unless this is explicitly "true".
# Leave false (or unset) to keep the agent fully inert. This overrides
# POLL_ENABLED, per-client sendMode, and SMS_AUTO_RESPONSES_ENABLED.
AGENT_ENABLED=false

# Google Cloud OAuth client (Cloud Console > APIs & Services > Credentials
# > Create Credentials > OAuth client ID > Application type: Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3456/oauth2callback

# Filled in automatically by `npm run auth` — leave blank for now
GOOGLE_REFRESH_TOKEN=

# log   = decide only, no Gmail action, just show what it would have done
# draft = create a real Gmail draft in jason@therealhelp.com, nothing sent
# send  = actually send
SEND_MODE=log

# Inbox poller (the real trigger). Leave OFF until you've tested with /api/poll-now.
# When ON, the server checks the inbox every POLL_INTERVAL_MS for unread mail.
POLL_ENABLED=false
POLL_INTERVAL_MS=120000

PORT=3456

# Dashboard / API authentication (HTTP Basic Auth)
# Set both in Railway Variables before going live with real client data
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Where poller crash alerts get emailed. Defaults to jason@therealhelp.com if unset.
ALERT_EMAIL=jason@therealhelp.com

# =============================================================================
# SMS OUTREACH (separate subsystem — dashboard at /outreach.html)
# =============================================================================

# Twilio credentials (Console > Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Comma-separated sending numbers in E.164. Buy 3+ local numbers for rotation.
TWILIO_NUMBERS=+15551234567,+15557654321,+15559876543
# Full public URL Twilio POSTs inbound replies to (used to verify signatures).
# e.g. https://your-app.up.railway.app/sms/webhook
TWILIO_WEBHOOK_URL=

# SAFETY: true = simulate everything, never actually hit Twilio. Flip to false
# only after you've tested and registered A2P 10DLC. Defaults to true.
SMS_DRY_RUN=true

# Default safety stop: inbound messages are recorded but never receive an
# automatic SMS response. Set true only when automatic replies are intended.
SMS_AUTO_RESPONSES_ENABLED=false

# Use Claude to write a unique, non-templated opener per lead (reuses ANTHROPIC_API_KEY).
SMS_AI_PERSONALIZE=true

# Deliverability guardrails
SMS_DAILY_LIMIT_PER_NUMBER=400
SMS_MIN_DELAY_MS=20000
SMS_MAX_DELAY_MS=45000

# TCPA quiet hours (local to each contact's area-code timezone). 9 to 20 = 9am-8pm.
SMS_QUIET_START_HOUR=9
SMS_QUIET_END_HOUR=20
SMS_BUSINESS_TIMEZONE=America/New_York

# Campaign voice / angle used by the personalizer
SMS_SENDER_NAME=Jason
SMS_BRAND=TheRealHelp
SMS_WEBSITE=www.therealhelp.com
SMS_CAMPAIGN_ANGLE=a business consultant who helps local business owners cut operational waste and grow

# Optional: relocate the SMS data store (defaults to ./sms-data.json)
# SMS_DATA_FILE=sms-data.json

# =============================================================================
# COLD CALL DIALER (dashboard at /dialer.html)
# =============================================================================

# Where leads, notes and the call log are stored. On Railway the container disk
# is wiped on every deploy: attach a Volume mounted at /data and keep this path.
DIALER_DATA_FILE=/data/dialer-data.json

# Your time zone (for "today" on the scoreboard).
DIALER_USER_TZ=America/Chicago

# Time zone assumed for leads with no state on file (calling-hours check).
DIALER_DEFAULT_TZ=America/New_York

# Reply-To on follow-up drafts created through the Gmail API.
DIALER_REPLY_TO=info@thecdscloud.com

# Sender address on all Gmail API mail (the old default was jason@therealhelp.com).
GMAIL_FROM_EMAIL=info@thecdscloud.com
