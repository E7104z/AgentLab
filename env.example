# ===========================================================================
# AgentLab environment. Copy to .env locally, or set these in Railway Variables.
# Key names only. Never commit real values.
# ===========================================================================

# --- Master kill switch (fail-safe) ---
# Nothing goes out (no send, no draft, no inbox check, no portal invite) unless this is "true".
# A redeploy always resets the switch to this value. The dashboard button flips it at runtime.
AGENT_ENABLED=false

# --- Database (Railway Postgres plugin provides this) ---
DATABASE_URL=

# --- Claude ---
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5
MODEL_WRITER=claude-sonnet-5-5

# --- Google OAuth client (Cloud Console > APIs & Services > Credentials > OAuth client ID > Desktop app) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3456/oauth2callback

# --- Mailbox refresh tokens: GMAIL_REFRESH_TOKEN_<MAILBOX NAME> ---
# Run `npm run auth` signed in as info@thecdscloud.com and paste the printed line.
GMAIL_REFRESH_TOKEN_MAIN=

# --- Inbox polling ---
POLL_ENABLED=false
POLL_INTERVAL_MS=120000
TICK_INTERVAL_MS=30000

# --- Dashboard login (required; the dashboard refuses to open without both) ---
ADMIN_USER=
ADMIN_PASSWORD=

# --- Where alerts and the daily digest go ---
ALERT_EMAIL=info@thecdscloud.com

# --- Public URL of this app (used for links in alerts) ---
APP_BASE_URL=

# --- Webhook secrets ---
# Shared with the-real-help (Vercel: AGENTLAB_LEAD_SECRET)
LEAD_WEBHOOK_SECRET=
# Set the same value as the Cal.com webhook "secret"
CAL_WEBHOOK_SECRET=

# --- Stripe (test mode keys until you go live) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs: $500 one-time product, $30/month recurring
STRIPE_PRICE_SETUP=
STRIPE_PRICE_MONTHLY=
STRIPE_SUCCESS_URL=https://therealhelp.com/?paid=1
STRIPE_CANCEL_URL=https://therealhelp.com/

# --- Proposals (Google Docs) ---
# Optional template doc with {{ShortName}} placeholders. Without it, a plain doc is generated.
PROPOSAL_TEMPLATE_DOC_ID=
PROPOSAL_FOLDER_ID=
PROPOSAL_SHARE_WITH_LINK=true

# --- Optional: weekly scorecard rows go to the "Scorecard" tab of this Sheet ---
SCORECARD_SHEET_ID=

# --- Client portal invites (the-real-help Firebase project) ---
PORTAL_INVITE_ENABLED=false
# Full service-account JSON on one line
PORTAL_FIREBASE_SERVICE_ACCOUNT=

# --- Cold Call Dialer (dashboard at /dialer.html) ---
# Storage: the dialer uses Postgres (DATABASE_URL) and imports the old data file once on first start.
# Set DIALER_STORAGE=file to go back to the single JSON file (then keep DIALER_DATA_FILE on a Railway Volume).
# DIALER_STORAGE=file
# DIALER_DATA_FILE=/data/dialer-data.json
# Nightly gzip backups, kept 14 days. Put this on the Railway Volume.
DIALER_BACKUP_DIR=/data/backups
# Your time zone (scoreboard "today", the 2am backup, and the two dates offered on calls).
DIALER_USER_TZ=America/Chicago
# Time zone assumed for leads with no state on file (calling-hours check).
DIALER_DEFAULT_TZ=America/New_York
# Follow-up emails open in jason@realhelpstl.com (change in the dialer's Settings tab). The CAN-SPAM
# mailing address is set there too, or here:
# DIALER_POSTAL_ADDRESS=123 Main St, St. Louis, MO 63101
# Marking a lead Do Not Call also lists their email on this sheet's suppression tab, the same list
# real-help-agent's leads preflight reads. Sheet id of that spreadsheet and its tab name.
SUPPRESSION_SHEET_ID=
SUPPRESSION_TAB=Suppression
