# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...

# Google Cloud OAuth client (Cloud Console > APIs & Services > Credentials
# > Create Credentials > OAuth client ID > Application type: Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3456/oauth2callback

# Filled in automatically by `npm run auth` — leave blank for now
GOOGLE_REFRESH_TOKEN=

# log   = decide only, no Gmail action, just show what it would have done
# draft = create a real Gmail draft in jason@therealhelp.com, nothing sent
# send  = actually send
SEND_MODE=log

# Inbox poller (the real trigger). Leave OFF until you've tested with /api/poll-now.
# When ON, the server checks the inbox every POLL_INTERVAL_MS for unread mail.
POLL_ENABLED=false
POLL_INTERVAL_MS=120000

PORT=3456

# Dashboard / API authentication (HTTP Basic Auth)
# Set both in Railway Variables before going live with real client data
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
